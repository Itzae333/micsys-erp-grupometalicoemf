# ─────────────────────────────────────────────────────────────
# GrupoMetalicoEMF API — Variables de entorno
# Copia este archivo como .env y rellena los valores reales.
# En Railway configura estas mismas variables desde el dashboard.
# ─────────────────────────────────────────────────────────────

# Base de datos (Railway provee este valor con el plugin PostgreSQL)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/railway?sslmode=require"

# JWT — Genera el secreto con: openssl rand -base64 64
# El access_token es la ÚNICA credencial (sin refresh_token/cookie). La
# sesión NUNCA debe cerrarse sola por inactividad — solo por "Cerrar todas
# las sesiones" (token_version) o porque un admin desactiva al usuario.
# 3650d (~10 años) es el "para siempre" práctico, evita casos límite de un
# valor realmente infinito.
JWT_SECRET="CAMBIA_POR_UN_SECRETO_LARGO_Y_ALEATORIO"
JWT_EXPIRES_IN="3650d"

# CORS — URL publica del frontend sin barra al final
# Desarrollo: http://localhost:3000  |  Produccion: https://tu-app.vercel.app
FRONTEND_URL="http://localhost:3000"

# Servidor
PORT=3001
NODE_ENV=development

# URL publica donde ESTE API sirve /uploads/ (logos) — sin barra al final.
# Necesaria para que el logo se vea en los correos (ahi no hay origen desde
# el cual resolver rutas relativas como en el navegador).
# Desarrollo: http://localhost:3001  |  Produccion: URL publica del API en Railway
API_PUBLIC_URL="http://localhost:3001"

# Email (Nodemailer) — opcional, para send-email
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="tu-correo@gmail.com"
SMTP_PASS="xxxx xxxx xxxx xxxx"
SMTP_FROM="GrupoMetalicoEMF <no-reply@grupometalicoemf.com>"
